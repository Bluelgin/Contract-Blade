{
  "format_version": "1.19.0",
  "animation_controllers": {
    "player.parallel_akatsuki_spirit_tail": {
      "initial_state": "hidden",
      "states": {
        "hidden": {
          "animations": [
            "akatsuki_spirit_hidden"
          ],
          "transitions": [
            {
              "visible": "ysm.has_helmet && !ctrl.death"
            }
          ],
          "blend_transition": 0.3,
          "blend_via_shortest_path": true
        },
        "visible": {
          "animations": [
            "akatsuki_spirit_visible"
          ],
          "transitions": [
            {
              "hidden": "!ysm.has_helmet || ctrl.death"
            }
          ],
          "blend_transition": 0.24,
          "blend_via_shortest_path": true
        }
      }
    }
  }
}
